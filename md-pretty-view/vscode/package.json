{
  "name": "md-pretty-view",
  "displayName": "MD Pretty View",
  "description": "A clean, polished look for Markdown Preview Enhanced: one-lever light/dark theme, a consistent editor-style syntax palette, styled Mermaid diagrams, and Mermaid pan/zoom & fit-to-screen. Installs the styling into your Markdown Preview Enhanced config folder.",
  "version": "0.0.8",
  "publisher": "masoud-pourhasan",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Formatters",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown view",
    "markdown viewer",
    "markdown style",
    "markdown format",
    "markdown formatter",
    "markdown formatting",
    "markdown preview",
    "markdown-preview-enhanced",
    "mpe",
    "preview",
    "mermaid",
    "theme",
    "syntax highlighting",
    "code blocks",
    "dark mode",
    "light mode",
    "documentation",
    "csharp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/masoud-pourhasan/customized-extensions.git",
    "directory": "md-pretty-view/vscode"
  },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "icon": "node scripts/render-icon.mjs",
    "postinstall": "node scripts/sync-shared.mjs",
    "vscode:prepublish": "node scripts/sync-shared.mjs"
  },
  "extensionDependencies": [
    "shd101wyy.markdown-preview-enhanced"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdPrettyView.apply",
        "title": "MD Pretty View: Apply Theme (Global)"
      },
      {
        "command": "mdPrettyView.remove",
        "title": "MD Pretty View: Remove Theme (Global)"
      },
      {
        "command": "mdPrettyView.toggleMode",
        "title": "MD Pretty View: Toggle Light / Dark"
      }
    ],
    "configuration": {
      "title": "MD Pretty View",
      "properties": {
        "mdPrettyView.applyMpeSettings": {
          "type": "boolean",
          "default": true,
          "description": "When applying the theme, also set the recommended markdown-preview-enhanced.* settings globally (previewTheme none.css, codeBlockTheme vscode.css). Note: enabling Mermaid pan/zoom also turns on markdown-preview-enhanced.enableScriptExecution."
        }
      }
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
